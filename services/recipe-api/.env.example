# ── jkOS Auth ────────────────────────────────────────────────────────────────
# RS256 public key from jkos-auth (copy from jkos-auth/.env)
JKOS_AUTH_PUBLIC_KEY=YOUR_RSA_PUBLIC_KEY_FROM_JKOS_AUTH_ENV

# ── CORS ─────────────────────────────────────────────────────────────────────
SHELL_URL=https://jkos.net

# ── LazurOS AI ───────────────────────────────────────────────────────────────
# LazurOS runs on the host network at :8080. Containers reach it via
# host.docker.internal (requires extra_hosts in docker-compose).
LAZUROS_URL=http://host.docker.internal:8080
LAZUROS_TOKEN=YOUR_LAZUROS_TOKEN_FROM_LAZUROS_ENV
LAZUROS_DEFAULT_MODEL=llama3.2
