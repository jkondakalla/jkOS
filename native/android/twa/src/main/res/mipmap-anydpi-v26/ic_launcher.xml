<?xml version="1.0" encoding="utf-8"?>
<!-- The shell's icon IS its start app's web maskable icon: ic_launcher_art is copied from
     apps/<start>/public/ at build time (ShellIcon, native/android/build.gradle.kts). That PNG
     is full-bleed and keeps its mark inside Android's 66 dp safe circle. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shell_bar" />
    <foreground android:drawable="@drawable/ic_launcher_art" />
</adaptive-icon>
