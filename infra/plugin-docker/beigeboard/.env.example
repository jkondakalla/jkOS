# BeigeBoard API — environment variables
# Copy this to .env and fill in all values before running docker-compose.

# ── CORS: set to your public domain in production ────────────────────────────
SHELL_URL=https://YOUR_DOMAIN

# ── Google Calendar OAuth2 ────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/beigeboard/api/auth/google/callback

# ── Microsoft (Outlook) Calendar OAuth2 ──────────────────────────────────────
# Register at: https://portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_CLIENT_SECRET
MICROSOFT_REDIRECT_URI=https://YOUR_DOMAIN/api/beigeboard/api/auth/outlook/callback

# ── LazurOS AI (compute proxy) ────────────────────────────────────────────────
# LazurOS runs on host network — docker containers reach it via host.docker.internal
LAZUROS_URL=http://host.docker.internal:8080
LAZUROS_TOKEN=YOUR_LAZUROS_API_TOKEN
LAZUROS_DEFAULT_MODEL=llama3.2
