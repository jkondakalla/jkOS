# LazurOS — environment variables
# Copy this to .env and fill in all values before running docker-compose.

# ── CORS: set to your public domain in production ─────────────────────────────
SHELL_URL=https://YOUR_DOMAIN

# ── Comma-separated allowed Google emails (empty = any Google account) ─────────
ALLOWED_EMAILS=

# ── Compute node (the Linux desktop that runs Ollama) ────────────────────────
COMPUTE_NODE_IP=192.168.X.XXX
COMPUTE_NODE_MAC=XX:XX:XX:XX:XX:XX
COMPUTE_API_PORT=11434

# ── LazurOS listen port (hardcoded to 8080 in Dockerfile — change both here) ──
LAZUROS_LISTEN_PORT=8080

# ── How long to wait for the compute node to wake before returning 503 ─────────
WAKE_TIMEOUT_SECONDS=45
