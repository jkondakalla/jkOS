# AI provider for nightly segment generation (ollama | lazuros | none)
AI_PROVIDER=ollama

# Ollama — running on your compute node (host.docker.internal reaches TrueNAS host gateway)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# LazurOS (if AI_PROVIDER=lazuros)
LAZUROS_URL=http://host.docker.internal:8080
LAZUROS_TOKEN=

# Nightly cron schedule (default: 2am)
NIGHTLY_CRON=0 2 * * *

# URL of the standalone SylibOS app (used by widget deep links)
VITE_SYLIBOS_APP_URL=https://sylibos.jkos.net
