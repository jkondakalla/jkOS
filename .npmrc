auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false

# Modern `pnpm deploy`: hardlinks the deployed package + its workspace deps from
# the store instead of the legacy ~5-min file-by-file copy of the whole prod
# tree. pnpm v10 only enables it when inject-workspace-packages is recorded in
# the lockfile — this replaces the old force-legacy-deploy=true escape hatch.
# Tradeoff: workspace packages are now INJECTED (hardlinked copies) into their
# consumers instead of symlinked, so after editing a packages/* SOURCE file run
# `pnpm install` for the change to propagate in local dev. Docker builds always
# reinstall, so image builds are unaffected.
inject-workspace-packages=true

# ZFS/Docker: copy_file_range returns spurious EAGAIN under overlay-on-ZFS
# (TrueNAS) and pnpm's store→node_modules copyfile dies mid-install. hardlink
# imports use link() and never touch that syscall — THIS is the real EAGAIN fix.
# Because hardlink (not concurrency) is what prevents EAGAIN, child-concurrency=1
# was removed: it only serialised installs and made cold builds ~6x slower
# (~13 min → ~7.5 min jkauth). Parallel installs are safe with hardlink imports.
package-import-method=hardlink
