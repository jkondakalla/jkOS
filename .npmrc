auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
force-legacy-deploy=true
# ZFS/Docker: copy_file_range returns spurious EAGAIN under overlay-on-ZFS
# (TrueNAS) and pnpm's store→node_modules copyfile dies mid-install. hardlink
# imports use link() and never touch that syscall — THIS is the real EAGAIN fix.
# Because hardlink (not concurrency) is what prevents EAGAIN, child-concurrency=1
# was removed: it only serialised installs and made cold builds ~6x slower
# (~13 min → ~7.5 min jkauth). Parallel installs are safe with hardlink imports.
#
# NOTE: the remaining cost is the legacy `pnpm deploy` copy (~5 min/image). The
# modern deploy is much faster but needs inject-workspace-packages=true recorded
# in pnpm-lock.yaml (a lockfile regen) — a separate, deliberate follow-up.
package-import-method=hardlink
