{
  "name": "jkos",
  "private": true,
  "version": "1.0.0",
  "description": "jkOS — self-hosted suite. ORDECK, jkAuth, BeigeBoard, LazurOS and KourOS, sharing @jkos/* packages; native Android + Linux desktop shells in native/.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:contracts": "node test/gate.mjs",
    "check:tokens": "node scripts/sync-tokens.mjs --check && node test/tokens-parity.mjs",
    "check:nginx": "node infra/nginx/gen-nginx-weave.mjs --check",
    "check:responsive": "node test/responsive.mjs",
    "check:drag": "node test/drag.mjs",
    "check:cards": "node test/cards-purity.mjs",
    "check:routine": "node test/routine-spec.mjs",
    "check:hud": "node apps/ordeck/scripts/check-hud-doc.mjs",
    "check:docker": "node test/dockerfile-inject.mjs",
    "check:async-view": "node test/async-view.mjs",
    "check:overlay": "node test/overlay-panel.mjs",
    "check:design": "node test/design-page.mjs",
    "check:fields": "node test/fields.mjs",
    "check:scroll": "node test/scrollbar.mjs",
    "check:text": "node test/text-purity.mjs",
    "check:today": "node test/today.mjs",
    "check:refs": "node test/refs.mjs",
    "check:binding": "node test/binding.mjs",
    "check:pulsarmap": "node test/pulsarmap.mjs",
    "check:vibespace": "node test/vibespace.mjs",
    "check:session": "node test/session-client.mjs",
    "check:scene": "node test/scene.mjs",
    "check:runes": "node test/runes.mjs",
    "check:token-identity": "node test/token-identity.mjs",
    "check:columns": "node test/columns.mjs",
    "check:rulings": "node test/rulings.mjs",
    "check:scopes": "node packages/suite-manifest/scripts/gen-scopes.mjs --check",
    "check:audit": "node test/supply-chain.mjs",
    "check:native": "node native/gen-native.mjs --check && node test/native.mjs",
    "check:secrets": "node test/secrets.mjs",
    "check:policy": "node test/policy.mjs",
    "check:auth": "node test/auth-single-source.mjs",
    "check:docs": "node test/docs.mjs",
    "test:cards": "node test/cards-logic.mjs",
    "check:build": "pnpm --filter @jkos/ordeck --filter @jkos/beigeboard --filter @jkos/kouros build",
    "prove": "node packages/suite-prober/prove.mjs",
    "roundtrip": "node packages/suite-prober/roundtrip.mjs",
    "new-app": "node scripts/new-app.mjs",
    "android:signing": "node native/android/signing.mjs",
    "android:build": "node native/android/build.mjs",
    "native:gen": "node native/gen-native.mjs",
    "sync:tokens": "node scripts/sync-tokens.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
