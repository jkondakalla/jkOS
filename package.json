{
  "name": "jkos",
  "private": true,
  "version": "1.0.0",
  "description": "jkOS — self-hosted suite. Hub platform (ordeck, jkauth, beigeboard, lazuros) + pluggable apps (sylibos), sharing @jkos/* packages.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["bcrypt", "better-sqlite3", "esbuild"]
  }
}
