JKOS_AUTH_PUBLIC_KEY=   # copy from jkos-auth/.env — same key, \n-escaped
STAGING_BRANCH=staging  # git branch name used for staging
BREAK_GLASS_TOKEN=      # ARCH-8: static admin bearer, accepted ONLY while jkAuth is
                        # unreachable (recovery path). openssl rand -hex 32. Unset = off.
                        # Keep on the host env only, NEVER commit. See OPERATIONS.md.
