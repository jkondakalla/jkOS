# BeigeBoard — standalone deployment env vars
# Copy to .env and fill in every value before running docker compose up.
#
# REQUIRED:
#   JKOS_AUTH_PUBLIC_KEY (or JKOS_AUTH_JWKS_URI), GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#
# OPTIONAL — Outlook calendar sync:  MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET
# OPTIONAL — iCloud calendar sync:   no keys (per-user app password entered in the UI)
# OPTIONAL — AI task parsing:        LAZUROS_TOKEN + BB_AI_ENABLED=true
# RECOMMENDED — secrets at rest:     CALENDAR_ENC_KEY
#
# Compose-managed (do NOT set here — the environment: block in docker-compose*.yml
# owns them): PORT, DB_PATH, STATIC_DIR. Staging additionally sets JKOS_AUTH_ISSUER
# and JKOS_COOKIE_SUFFIX in docker-compose.staging.yml.
#
# After filling in, start with:
#   docker compose up -d --build

# ── jkOS Auth (SSO) ──────────────────────────────────────────────────────────
# Verify jkos_token cookies (RS256). Prefer JWKS-by-kid for key rotation; otherwise
# pin the static public key. Set exactly one.
#   openssl genrsa -out jkos_private.pem 2048
#   openssl rsa -in jkos_private.pem -pubout -out jkos_public.pem
# Inline newlines as \n before pasting the key here.
JKOS_AUTH_PUBLIC_KEY=
# JWKS endpoint of the jkos-auth service (takes precedence over the static key):
# JKOS_AUTH_JWKS_URI=https://auth.jkos.net/.well-known/jwks.json
# Frontend must know the auth origin at BUILD time (passed to Vite as a build arg;
# staging overrides it in docker-compose.staging.yml). Origin only — no /auth suffix.
VITE_JKOS_AUTH_URL=https://auth.jkos.net

# ── Subdomain & CORS ─────────────────────────────────────────────────────────
# Must match the domain nginx terminates SSL for. Always allowed as an origin.
SHELL_URL=https://beigeboard.jkos.net
# Extra cross-origin callers (comma-separated) — a second suite app calling BeigeBoard.
# SHELL_URL is always included; list only ADDITIONAL origins here.
# ALLOWED_ORIGINS=https://staging.jkos.net,https://ordeck.jkos.net

# ── Secret-at-rest encryption (recommended) ──────────────────────────────────
# 64 hex chars → AES-256-GCM for calendar OAuth refresh tokens + the iCloud app
# password at rest. Generate: openssl rand -hex 32
# Unset → tokens store plaintext (safe no-op). Adding a key later is safe (dual-read);
# REMOVING/CHANGING it after encryption breaks those rows — see OPERATIONS.md.
CALENDAR_ENC_KEY=

# ── Google Calendar OAuth2 ────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://beigeboard.jkos.net/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://beigeboard.jkos.net/api/auth/google/callback

# ── Microsoft / Outlook OAuth2 (optional) ────────────────────────────────────
# Create at: https://portal.azure.com → App registrations
# Authorized redirect URI: https://beigeboard.jkos.net/api/auth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://beigeboard.jkos.net/api/auth/outlook/callback

# ── LazurOS AI (optional — for NL task parsing) ───────────────────────────────
# Docker containers reach LazurOS (host network, port 8080) via host.docker.internal.
# BB_AI_ENABLED must be 'true' to expose the /api/ai/* routes at all.
BB_AI_ENABLED=false
LAZUROS_URL=http://host.docker.internal:8080
LAZUROS_TOKEN=
LAZUROS_DEFAULT_MODEL=llama3.2

# ── Data volume path ─────────────────────────────────────────────────────────
# On TrueNAS: leave unset — defaults to /mnt/Luna/Backends/Production/beigeboard-data
# Local dev:  set to a local path, e.g.:
# BEIGEBOARD_DATA_PATH=../Backends/beigeboard-data
