# BeigeBoard — standalone deployment env vars
# Copy to .env and fill in every value before running docker compose up.
#
# REQUIRED:
#   JKOS_AUTH_PUBLIC_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#
# OPTIONAL — Outlook calendar sync:
#   MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET
#
# OPTIONAL — AI task parsing:
#   LAZUROS_TOKEN
#
# After filling in, start with:
#   docker compose up -d --build

# ── jkOS Auth (SSO) ──────────────────────────────────────────────────────────
# Public key of the jkos-auth service (RS256). Generate the keypair:
#   openssl genrsa -out jkos_private.pem 2048
#   openssl rsa -in jkos_private.pem -pubout -out jkos_public.pem
# Inline newlines as \n before pasting here.
JKOS_AUTH_PUBLIC_KEY=
JKOS_AUTH_URL=https://auth.jkos.net
# Frontend must also know the auth URL (passed to Vite at build time)
VITE_JKOS_AUTH_URL=https://auth.jkos.net

# ── Subdomain & CORS ─────────────────────────────────────────────────────────
# Must match the domain nginx terminates SSL for.
SHELL_URL=https://beigeboard.jkos.net

# ── Google Calendar OAuth2 ────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://beigeboard.jkos.net/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://beigeboard.jkos.net/api/auth/google/callback

# ── Microsoft / Outlook OAuth2 (optional) ────────────────────────────────────
# Create at: https://portal.azure.com → App registrations
# Authorized redirect URI: https://beigeboard.jkos.net/api/auth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://beigeboard.jkos.net/api/auth/outlook/callback

# ── LazurOS AI (optional — for NL task parsing) ───────────────────────────────
# Docker containers reach LazurOS (host network, port 8080) via host.docker.internal.
LAZUROS_URL=http://host.docker.internal:8080
LAZUROS_TOKEN=
LAZUROS_DEFAULT_MODEL=llama3.2

# ── Data volume path ─────────────────────────────────────────────────────────
# On TrueNAS: leave unset — defaults to /mnt/Luna/Backends/BeigeBoard-Data
# Local dev:  set to a local path, e.g.:
# BEIGEBOARD_DATA_PATH=../Backends/BeigeBoard-Data
