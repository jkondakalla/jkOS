# BeigeBoard backend environment variables (development)
PORT=3001
DB_PATH=./beigeBoard.db

# jkOS Auth — RSA public key for validating jkos_token cookies (RS256)
# Leave blank in dev to use the unauthenticated fallback (user id=1, admin role)
JKOS_AUTH_PUBLIC_KEY=
JKOS_AUTH_URL=http://localhost:3100

# Google Calendar OAuth2 (calendar sync only — user auth is handled by jkos-auth)
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Microsoft / Outlook OAuth2 (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/auth/outlook/callback

# LazurOS AI compute
# Docker: http://host.docker.internal:8080
# Dev:    http://localhost:8080
LAZUROS_URL=http://localhost:8080
LAZUROS_TOKEN=
LAZUROS_DEFAULT_MODEL=llama3.2
