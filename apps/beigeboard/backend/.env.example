# BeigeBoard backend environment variables (local development)
# For a full-suite / Docker deployment use apps/beigeboard/.env.example instead —
# that template is the deployment source of truth (compose reads it via env_file).
PORT=3001
DB_PATH=./beigeBoard.db
# Where the built SPA is served from (defaults to ../dist). Rarely overridden in dev.
# STATIC_DIR=../dist

# jkOS Auth — verify jkos_token cookies (RS256). Leave BOTH blank in dev to use the
# unauthenticated fallback (user id=1, admin role). Set one to test real auth locally.
JKOS_AUTH_PUBLIC_KEY=
# JKOS_AUTH_JWKS_URI=http://localhost:3100/.well-known/jwks.json
# Optional issuer override (default 'jkos-auth'); staging uses 'jkos-auth-staging'.
# JKOS_AUTH_ISSUER=jkos-auth

# CORS. SHELL_URL is always an allowed origin; ALLOWED_ORIGINS adds more (comma-sep).
SHELL_URL=http://localhost:3000
# ALLOWED_ORIGINS=

# Secret-at-rest encryption (AES-256-GCM) for calendar OAuth refresh tokens + the
# iCloud app password. 64 hex chars: openssl rand -hex 32. Blank → plaintext (no-op).
CALENDAR_ENC_KEY=

# Google Calendar OAuth2 (calendar sync only — user auth is handled by jkos-auth)
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Microsoft / Outlook OAuth2 (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/auth/outlook/callback

# No AI env here. LazurOS writes its results INTO BeigeBoard through /api/items as
# the acting user (delegated write-back); BB never calls out to a model. See ToDo.md §1.
