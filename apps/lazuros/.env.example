# LazurOS — environment variables
# Copy this to .env and fill in all values.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Two accepted credentials (either works; both empty = open access, only safe
# if port 8080 is firewalled from WAN):
# 1. Static bearer token for server-to-server callers (SylibOS/BeigeBoard
#    backends, CLI): Authorization: Bearer <token>
LAZUROS_TOKEN=
# 2. jkOS SSO JWT (jkos_token cookie via the hub's /api/lazuros proxy, or a
#    JWT as the bearer). Same key/issuer contract as @jkos/auth-middleware.
JKOS_AUTH_PUBLIC_KEY=
JKOS_AUTH_ISSUER=jkos-auth

# ── CORS: origin of browser-based callers (ORDECK shell or BeigeBoard frontend) ─
SHELL_URL=https://beigeboard.jkos.net

# ── Compute node (the Linux desktop running Ollama) ──────────────────────────
COMPUTE_NODE_IP=192.168.X.XXX
COMPUTE_NODE_MAC=XX:XX:XX:XX:XX:XX
COMPUTE_API_PORT=11434

# ── LazurOS listen port (also hardcoded in Dockerfile — change both if needed) ─
LAZUROS_LISTEN_PORT=8080

# ── Wake behavior ─────────────────────────────────────────────────────────────
# Auto-send WoL when a /api/* request arrives while the node sleeps (this is
# what lets the SylibOS 2am nightly job run against a sleeping desktop).
# /health, /models and /ps never wake the node.
AUTO_WAKE=true
# How long to wait for the compute node to boot before returning 503.
WAKE_TIMEOUT_SECONDS=45
# Max seconds a generation request may stream before the proxy gives up.
GENERATION_TIMEOUT_SECONDS=600
