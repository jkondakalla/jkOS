# LazurOS — environment variables. Copy to .env and fill in.
#
# .env carries ONLY process-level secrets + jkAuth wiring. All hardware-specific values
# (inference backends, model tags, WoL MACs, tiers) live in deployment.json instead —
# copy a template (deployment.example.json or deployment.jag.json) to deployment.json
# and point LAZUROS_DEPLOYMENT_CONFIG at it. That separation is what lets the same
# Docker image run any self-hoster's hardware.

# ── Process ─────────────────────────────────────────────────────────────────────
PORT=8080
DB_PATH=/data/lazuros.db
LAZUROS_DEPLOYMENT_CONFIG=/app/deployment.json
LAZUROS_ENV=production

# ── jkAuth (Weave SSO) ──────────────────────────────────────────────────────────
# RS256 public key from jkos-auth (PEM, \n-escaped on one line) OR a JWKS URI for
# key rotation. In production weaveAuth refuses to start with neither set.
JKOS_AUTH_PUBLIC_KEY=
# JKOS_AUTH_JWKS_URI=https://auth.jkos.net/auth/jwks
JKOS_APP_ID=lazuros
# JKOS_AUTH_ISSUER=jkos-auth   # defaults via @jkos/auth-middleware; override only to repoint

# ── Service identity (for outbound delegated writes to BeigeBoard — Phase 6) ────
JKOS_SERVICE_CLIENT_ID=lazuros
JKOS_SERVICE_CLIENT_SECRET=
JKOS_AUTH_URL=http://jkos-auth:3100

# ── Internal worker API (compute-node worker authenticates with this) ───────────
LAZUROS_INTERNAL_TOKEN=

# ── CORS allowlist (same-origin edge means this is rarely hit; dev/cross-origin) ─
PORTAL_URL=https://jkos.net
AUTH_ORIGIN=https://auth.jkos.net
# ALLOWED_ORIGINS=https://beigeboard.jkos.net   # extra comma-separated browser origins
