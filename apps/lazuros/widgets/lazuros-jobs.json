{
  "id": "lazuros-jobs",
  "label": "LazurOS Jobs",
  "sizing": {
    "desktop": {
      "w": 4,
      "h": 6
    },
    "mobile": {
      "w": 2,
      "h": 5
    },
    "min": {
      "w": 3,
      "h": 4
    }
  },
  "spec": {
    "frame": {
      "eyebrow": "LAZUROS",
      "source": "JOBS",
      "empty": "No jobs yet — ask LazurOS something."
    },
    "sources": {
      "jobs": {
        "kind": "dataset",
        "app": "lazuros",
        "dataset": "jobs",
        "poll": 8
      }
    },
    "body": {
      "t": "rows",
      "from": {
        "src": "jobs"
      },
      "mark": {
        "src": "$",
        "path": "status",
        "map": {
          "DONE": "ok",
          "FAILED": "danger",
          "IN_PROGRESS": "accent",
          "PENDING_WAKEUP": "warn"
        },
        "fallback": "muted"
      },
      "lead": {
        "src": "$",
        "path": "status",
        "map": {
          "PENDING": "QUEUED",
          "PENDING_WAKEUP": "WAKING",
          "IN_PROGRESS": "RUNNING"
        }
      },
      "title": {
        "src": "$",
        "path": "capability"
      },
      "sub": {
        "src": "$",
        "path": "error"
      },
      "detail": {
        "src": "$",
        "path": "created_at",
        "fmt": "ago"
      },
      "max": 8
    }
  }
}
