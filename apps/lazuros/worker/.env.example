# LazurOS worker — compute-node-side env. Carries only the State-node wiring and the
# shared internal token; all model/prompt content lives in the JSON config files below.
LAZUROS_STATE_URL=http://STATE_NODE_HOST:8080
LAZUROS_INTERNAL_TOKEN=
POLL_INTERVAL_MS=2000

# Node-local config (the worker's own slice — never the State node's deployment.json).
LAZUROS_MODEL_MAP=/opt/lazuros/models.json
LAZUROS_PROMPT_MAP=/opt/lazuros/prompts.json

# Node-local inference runtime. Ollama by default; point at llama.cpp-server / vLLM
# / LM Studio (any /api/generate-compatible endpoint) if that's what runs on this node.
LAZUROS_OLLAMA_URL=http://localhost:11434
