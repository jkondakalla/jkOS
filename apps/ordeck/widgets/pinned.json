{
  "id": "pinned",
  "label": "Pinned",
  "sizing": {
    "desktop": {
      "w": 4,
      "h": 5
    },
    "mobile": {
      "w": 2,
      "h": 4
    }
  },
  "spec": {
    "frame": {
      "eyebrow": "PINNED",
      "source": "BEIGEBOARD"
    },
    "body": {
      "t": "when",
      "cond": {
        "src": "pinned",
        "path": "authed"
      },
      "then": {
        "t": "rows",
        "from": {
          "src": "pinned",
          "path": "items"
        },
        "lead": {
          "src": "$",
          "path": "timeLabel"
        },
        "title": {
          "src": "$",
          "path": "title"
        },
        "mark": {
          "src": "$",
          "path": "tone"
        },
        "href": {
          "src": "$",
          "path": "deeplink"
        },
        "empty": "Nothing pinned — pin a task in BeigeBoard."
      },
      "else": {
        "t": "text",
        "text": "Sign in to see pinned tasks.",
        "variant": "note"
      }
    }
  }
}
