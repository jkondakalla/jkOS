{
  "id": "today",
  "label": "Today",
  "sizing": {
    "desktop": {
      "w": 5,
      "h": 13
    },
    "mobile": {
      "w": 2,
      "h": 8
    },
    "min": {
      "w": 3,
      "h": 6
    }
  },
  "spec": {
    "frame": {
      "eyebrow": "TODAY",
      "source": "BEIGEBOARD"
    },
    "body": {
      "t": "stack",
      "gap": 10,
      "grow": true,
      "children": [
        {
          "t": "when",
          "cond": {
            "src": "today",
            "path": "signedOut"
          },
          "then": {
            "t": "stack",
            "gap": 8,
            "children": [
              {
                "t": "text",
                "text": "Sign in to see your day.",
                "variant": "note"
              },
              {
                "t": "link",
                "text": "LOG IN",
                "href": {
                  "src": "authUrl"
                }
              }
            ]
          }
        },
        {
          "t": "when",
          "cond": {
            "src": "today",
            "path": "showOffline"
          },
          "then": {
            "t": "stack",
            "gap": 8,
            "children": [
              {
                "t": "text",
                "text": "BeigeBoard is offline.",
                "variant": "note"
              },
              {
                "t": "link",
                "text": "OPEN BEIGEBOARD",
                "href": {
                  "src": "origins",
                  "path": "beigeboard"
                }
              }
            ]
          }
        },
        {
          "t": "when",
          "cond": {
            "src": "today",
            "path": "showEmpty"
          },
          "then": {
            "t": "text",
            "text": {
              "src": "today",
              "path": "emptyLabel"
            },
            "variant": "note"
          }
        },
        {
          "t": "when",
          "cond": {
            "src": "today",
            "path": "showTasks"
          },
          "then": {
            "t": "stack",
            "gap": 10,
            "grow": true,
            "children": [
              {
                "t": "meter",
                "label": "DONE",
                "value": {
                  "src": "today",
                  "path": "progress"
                },
                "detail": {
                  "src": "today",
                  "path": "progressLabel"
                }
              },
              {
                "t": "rows",
                "from": {
                  "src": "today",
                  "path": "tasks"
                },
                "lead": {
                  "src": "$",
                  "path": "timeLabel"
                },
                "title": {
                  "src": "$",
                  "path": "title"
                },
                "mark": {
                  "src": "$",
                  "path": "tone"
                }
              }
            ]
          }
        },
        {
          "t": "when",
          "cond": {
            "src": "today",
            "path": "canAdd"
          },
          "then": {
            "t": "form",
            "cmd": {
              "app": "beigeboard",
              "capability": "createItem",
              "body": {
                "title": {
                  "src": "$form",
                  "path": "title"
                },
                "due_date": {
                  "src": "clock",
                  "path": "iso"
                }
              }
            },
            "submit": "ADD",
            "children": [
              {
                "t": "input",
                "field": "title",
                "placeholder": "Add a task for today…"
              }
            ]
          }
        }
      ]
    }
  }
}
