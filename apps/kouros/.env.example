# KourOS backend — environment. Copy to .env (compose reads it via env_file).
# All optional in dev: with no key set, weaveAuth falls back to a dev identity stub.

# Identity (jkAuth). In prod set ONE of these to verify the jkos_token signature:
#   JKOS_AUTH_JWKS_URI   preferred — JWKS-by-kid, supports key rotation
#   JKOS_AUTH_PUBLIC_KEY the static RSA public key (PEM)
# JKOS_AUTH_JWKS_URI=https://auth.jkos.net/auth/.well-known/jwks.json
# JKOS_AUTH_PUBLIC_KEY=
# JKOS_AUTH_ISSUER=jkos-auth         # staging uses jkos-auth-staging

# Cross-origin: the shell origin + any extra peers allowed to call this API.
# SHELL_URL=https://jkos.net
# ALLOWED_ORIGINS=https://beigeboard.jkos.net

# Runtime (compose sets these; defaults are fine for local `npm start`).
# PORT=3011
# DB_PATH=/data/kouros.db
# STATIC_DIR=/app/dist

# Library scanner (ToDo §3 18.2): folder the boot scan + rescanLibrary walk, recursively
# — every audio file found anywhere under it becomes one `tracks` row (mp3/m4a/aac/
# flac/ogg/opus/wav). No separate DATA_DIR — cover art writes under DB_PATH's directory
# (/data/covers/<id>.jpg in prod), same convention as PapyrOS's AUDIOBOOKS_DIR.
#
# UNSET IN BOTH COMPOSE FILES TODAY — no NAS bind mount exists yet for this app (unlike
# PapyrOS's AUDIOBOOKS_DIR, which mounts /mnt/Luna/Luna/Plex/Audiobooks read-only). The
# real music library mount is Jag's own decision; until MUSIC_DIR is set (and a volume
# bind added to apps/kouros/docker-compose*.yml pointing at the real path), the boot
# scan runs against a directory that doesn't exist and degrades to a harmless 0-track
# no-op (logged, not fatal).
# MUSIC_DIR=/music
