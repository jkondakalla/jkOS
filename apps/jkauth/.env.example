# jkOS Auth Service environment variables
# Copy to .env and fill in all values before running docker compose up.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3100
DB_PATH=/data/jkos-auth.db

# Domain for HTTP-only cookies. Must be the apex domain so cookies are shared
# across all subdomains (beigeboard.jkos.net, sylibos.jkos.net, etc.)
COOKIE_DOMAIN=.jkos.net

# Public-facing origin of this auth service. Used to validate redirect_to
# parameters on login — prevents open redirect attacks.
AUTH_ORIGIN=https://auth.jkos.net

# URL to redirect authenticated users to after login (the jkOS portal).
PORTAL_URL=https://jkos.net

# ── RSA Keypair (RS256) ───────────────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out jkos_private.pem 2048
#   openssl rsa -in jkos_private.pem -pubout -out jkos_public.pem
# Then inline newlines as \n:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' jkos_private.pem
#
# JKOS_AUTH_PRIVATE_KEY stays here only. JKOS_AUTH_PUBLIC_KEY goes into every app's .env.
JKOS_AUTH_PRIVATE_KEY=
JKOS_AUTH_PUBLIC_KEY=

# ── Seed accounts (optional) ──────────────────────────────────────────────────
# Auto-creates the first admin on first boot. Leave blank to register via the UI.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# When set, enables "Continue as guest" and auto-creates the guest account.
# This IS the guest credential: POST /auth/guest verifies it against the stored
# hash (JK-A1), and a changed value re-syncs the hash at next boot.
GUEST_PASSWORD=

# ── Two-factor secret sealing (JK-A4) ─────────────────────────────────────────
# Envelope key for secrets the server must read back (the TOTP shared secret).
# Any sufficiently random string — e.g. `openssl rand -hex 32`. REQUIRED for new
# TOTP enrollment (setup 503s without it); existing plaintext secrets are sealed
# at the first boot that has the key. Losing this key invalidates every enrolled
# authenticator (users re-enroll); treat it like the signing key.
JKOS_2FA_ENC_KEY=

# ── Service clients + on-behalf-of delegation (G1) ────────────────────────────
# Backend-to-backend clients for the client-credentials grant (POST /auth/token).
# Format: "<id>:<secret>:<scopeA>|<scopeB>, <id2>:<secret2>:<scopeC>". A client may
# only ever be granted scopes from its own configured set.
#
# LazurOS (Phase 6): its worker writes parse-task / breakdown-goal results into
# BeigeBoard AS the acting user, so the `lazuros` service client must hold
# `beigeboard:write` (delegation supplies only the WHO, never the scope).
# JKOS_SERVICE_CLIENTS=lazuros:<secret>:beigeboard:write
#
# Delegation allow-list: only clients here MAY mint an on-behalf-of token (an `act`
# claim) — separate opt-in from the scope grant; a normal service client can never
# act as a user. Comma list of client ids.
# JKOS_DELEGATION_CLIENTS=lazuros

# ── Email (2FA one-time codes via Resend) ─────────────────────────────────────
# Optional: enables email-OTP as a second factor. Without a key, email 2FA is off
# and only TOTP is available. RESEND_API_KEY is a secret (keep it out of the repo).
# RESEND_API_KEY=
# EMAIL_FROM=jkOS <no-reply@jkos.net>
# Dev/test only: echo the generated OTP in the API response so a harness can read
# it. Never set in production.
# OTP_TEST_ECHO=1

# ── Signing-key rotation (S4/U3) ──────────────────────────────────────────────
# JKOS_AUTH_KID labels the ACTIVE key in the JWT header + JWKS (default '1'). To
# rotate without downtime, publish the NEXT key first (KID_NEXT + PUBLIC_KEY_NEXT):
# verifiers fetch it by kid before this service starts signing with it, then you
# promote it to the active PRIVATE/PUBLIC key + KID on the next deploy.
# JKOS_AUTH_KID=1
# JKOS_AUTH_KID_NEXT=2
# JKOS_AUTH_PUBLIC_KEY_NEXT=

# ── Tuning ────────────────────────────────────────────────────────────────────
# Grace window (ms) in which a concurrent double-refresh (two tabs) is treated as
# benign instead of token reuse. Default is fine; override only to tune. (S2/S9)
# REFRESH_GRACE_MS=10000
# Session lifetime policy (JK-A3), all ms. SESSION_TTL_MS is the idle window for
# an UNREMEMBERED login (default 24h; remembered logins use the 30-day refresh
# window). SESSION_ABSOLUTE_TTL_MS caps a family regardless of activity (default
# 90 days). SESSION_TOMBSTONE_MS is how long revoked-session evidence is kept
# before pruning (default 30 days, JK-A10).
# SESSION_TTL_MS=86400000
# SESSION_ABSOLUTE_TTL_MS=7776000000
# SESSION_TOMBSTONE_MS=2592000000

# ── Data volume path ─────────────────────────────────────────────────────────
# On TrueNAS: leave unset — defaults to /mnt/Luna/Backends/Production/jkos-auth-data
# Local dev:  set to a local path, e.g.:
# JKOS_AUTH_DATA_PATH=../Backends/jkos-auth-data
