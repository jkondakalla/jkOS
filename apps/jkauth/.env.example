# jkOS Auth Service environment variables
# Copy to .env and fill in all values before running docker compose up.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3100
DB_PATH=/data/jkos-auth.db

# Domain for HTTP-only cookies. Must be the apex domain so cookies are shared
# across all subdomains (beigeboard.jkos.net, sylibos.jkos.net, etc.)
COOKIE_DOMAIN=.jkos.net

# Public-facing origin of this auth service. Used to validate redirect_to
# parameters on login — prevents open redirect attacks.
AUTH_ORIGIN=https://auth.jkos.net

# URL to redirect authenticated users to after login (the jkOS portal).
PORTAL_URL=https://jkos.net

# ── RSA Keypair (RS256) ───────────────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out jkos_private.pem 2048
#   openssl rsa -in jkos_private.pem -pubout -out jkos_public.pem
# Then inline newlines as \n:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' jkos_private.pem
#
# JKOS_AUTH_PRIVATE_KEY stays here only. JKOS_AUTH_PUBLIC_KEY goes into every app's .env.
JKOS_AUTH_PRIVATE_KEY=
JKOS_AUTH_PUBLIC_KEY=

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://auth.jkos.net/auth/google/callback
# Scopes required: profile, email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://auth.jkos.net/auth/google/callback

# ── Seed accounts (optional) ──────────────────────────────────────────────────
# Auto-creates the first admin on first boot. Leave blank to register via the UI.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# When set, enables "Continue as guest" and auto-creates the guest account.
GUEST_PASSWORD=

# ── Data volume path ─────────────────────────────────────────────────────────
# On TrueNAS: leave unset — defaults to /mnt/Luna/Backends/Production/jkos-auth-data
# Local dev:  set to a local path, e.g.:
# JKOS_AUTH_DATA_PATH=../Backends/jkos-auth-data
